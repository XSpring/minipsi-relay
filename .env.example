# Settings of a CC in relay mode. Copy to .env and fill in; never commit .env.
# minipsi does not read this file itself: load it with `set -a; . ./.env; set +a`,
# `docker run --env-file .env` or systemd's EnvironmentFile=.

# ID of this CC, as the orchestrator knows it.
MINIPSI_CC_ID=cc-1

# Base URL of the orchestrator (http or https).
MINIPSI_ORC_URL=http://localhost:8080
